  "solution_reveal_policy": "Instructor reference and mutation files are excluded from learner starter copies; reveal only on an explicit learner request or after an accepted attempt.",
  "checks": [
    {"id":"compile-c17","description":"Compile both learner translation units, the separate test driver, and the supplied sample adapter without warnings.","kind":"compile","expected":{"exit_code":0,"warnings":0}},
    {"id":"analysis-sample","description":"Compute exact statistics for the six-reading sample.","kind":"assertion-harness","inputs":{"readings":[12,18,9,21,15,24],"count":6},"expected":{"status":"ok","count":6,"sum":99,"minimum":9,"maximum":24,"mean":16.5,"mean_tolerance":1e-6}},
    {"id":"stdout-sample","description":"Emit the sample report using the exact JSON schema and key order.","kind":"stdout","normalization":"json-object","inputs":{"case":"sample"},"expected":{"status":"ok","count":6,"sum":99,"minimum":9,"maximum":24,"mean":16.5,"mean_tolerance":1e-6}},
    {"id":"report-write-sample","description":"Return success after writing the sample report.","kind":"assertion-harness","inputs":{"case":"sample"},"expected":{"return":0}},
    {"id":"analysis-empty","description":"Return explicit empty status and all-zero API fields for zero count.","kind":"assertion-harness","inputs":{"count":0,"adapter_buffer":"non-null one-element guard"},"expected":{"status":"empty","count":0,"sum":0,"minimum":0,"maximum":0,"mean":0}},
    {"id":"stdout-empty","description":"Use null for empty minimum, maximum, and mean.","kind":"stdout","normalization":"json-object","inputs":{"case":"empty"},"expected":{"status":"empty","count":0,"sum":0,"minimum":null,"maximum":null,"mean":null}},
    {"id":"report-write-empty","description":"Return success after writing an empty report.","kind":"assertion-harness","inputs":{"case":"empty"},"expected":{"return":0}},
    {"id":"analysis-single","description":"Handle one reading and equal extrema.","kind":"assertion-harness","inputs":{"readings":[42],"count":1},"expected":{"status":"ok","count":1,"sum":42,"minimum":42,"maximum":42,"mean":42}},
    {"id":"stdout-single","description":"Serialize the one-reading result.","kind":"stdout","normalization":"json-object","inputs":{"case":"single"},"expected":{"status":"ok","count":1,"sum":42,"minimum":42,"maximum":42,"mean":42}},
    {"id":"report-write-single","description":"Return success after writing the single-reading report.","kind":"assertion-harness","inputs":{"case":"single"},"expected":{"return":0}},
    {"id":"analysis-zeros","description":"Distinguish measured zeros from empty input by status and count.","kind":"assertion-harness","inputs":{"readings":[0,0,0],"count":3},"expected":{"status":"ok","count":3,"sum":0,"minimum":0,"maximum":0,"mean":0}},
    {"id":"stdout-zeros","description":"Serialize measured zero extrema as numbers.","kind":"stdout","normalization":"json-object","inputs":{"case":"zeros"},"expected":{"status":"ok","count":3,"sum":0,"minimum":0,"maximum":0,"mean":0}},
    {"id":"report-write-zeros","description":"Return success after writing the all-zero measurements report.","kind":"assertion-harness","inputs":{"case":"zeros"},"expected":{"return":0}},
    {"id":"analysis-repeated","description":"Preserve the true count and equal extrema for repeated values.","kind":"assertion-harness","inputs":{"readings":[7,7,7,7],"count":4},"expected":{"status":"ok","count":4,"sum":28,"minimum":7,"maximum":7,"mean":7}},
    {"id":"stdout-repeated","description":"Serialize repeated readings.","kind":"stdout","normalization":"json-object","inputs":{"case":"repeated"},"expected":{"status":"ok","count":4,"sum":28,"minimum":7,"maximum":7,"mean":7}},
    {"id":"report-write-repeated","description":"Return success after writing repeated readings.","kind":"assertion-harness","inputs":{"case":"repeated"},"expected":{"return":0}},
    {"id":"analysis-fractional-mean","description":"Use the actual count as denominator and meet the absolute tolerance.","kind":"assertion-harness","inputs":{"readings":[1,2,10],"count":3},"expected":{"status":"ok","count":3,"sum":13,"minimum":1,"maximum":10,"mean":4.333333333333333,"mean_tolerance":1e-6}},
    {"id":"stdout-fractional-mean","description":"Serialize the fractional mean as a JSON number within tolerance.","kind":"stdout","normalization":"json-object","inputs":{"case":"fractional-mean"},"expected":{"status":"ok","count":3,"sum":13,"minimum":1,"maximum":10,"mean":4.333333333333333,"mean_tolerance":1e-6}},
    {"id":"report-write-fractional-mean","description":"Return success after writing a fractional mean.","kind":"assertion-harness","inputs":{"case":"fractional-mean"},"expected":{"return":0}},
    {"id":"analysis-max-capacity","description":"Handle 30 maximum values without int overflow.","kind":"assertion-harness","inputs":{"reading":1000,"count":30},"expected":{"status":"ok","count":30,"sum":30000,"minimum":1000,"maximum":1000,"mean":1000}},
    {"id":"stdout-max-capacity","description":"Serialize the maximum-capacity report.","kind":"stdout","normalization":"json-object","inputs":{"case":"max-capacity"},"expected":{"status":"ok","count":30,"sum":30000,"minimum":1000,"maximum":1000,"mean":1000}},
    {"id":"report-write-max-capacity","description":"Return success after writing the capacity report.","kind":"assertion-harness","inputs":{"case":"max-capacity"},"expected":{"return":0}},
    {"id":"analysis-count-sentinel","description":"Honor the logical count when another valid object is physically accessible.","kind":"assertion-harness","inputs":{"readings":[2,4,6,777],"count":3},"expected":{"status":"ok","count":3,"sum":12,"minimum":2,"maximum":6,"mean":4}},
    {"id":"stdout-count-sentinel","description":"Do not include the sentinel in the report.","kind":"stdout","normalization":"json-object","inputs":{"case":"count-sentinel"},"expected":{"status":"ok","count":3,"sum":12,"minimum":2,"maximum":6,"mean":4}},
    {"id":"report-write-count-sentinel","description":"Return success after writing the bounded-prefix report.","kind":"assertion-harness","inputs":{"case":"count-sentinel"},"expected":{"return":0}},
    {"id":"analysis-invalid-low","description":"Reject a negative reading and publish only zero fields.","kind":"assertion-harness","inputs":{"readings":[20,-1],"count":2},"expected":{"status":"reading_out_of_range","count":0,"sum":0,"minimum":0,"maximum":0,"mean":0}},
    {"id":"stdout-invalid-low","description":"Serialize the low-range error without fabricated measurements.","kind":"stdout","normalization":"json-object","inputs":{"case":"invalid-low"},"expected":{"status":"reading_out_of_range","count":0,"sum":0,"minimum":null,"maximum":null,"mean":null}},
    {"id":"report-write-invalid-low","description":"Return success after writing a low-range error report.","kind":"assertion-harness","inputs":{"case":"invalid-low"},"expected":{"return":0}},
    {"id":"analysis-invalid-high","description":"Reject a reading above 1000 and leave fields zero.","kind":"assertion-harness","inputs":{"readings":[1001],"count":1},"expected":{"status":"reading_out_of_range","count":0,"sum":0,"minimum":0,"maximum":0,"mean":0}},
    {"id":"stdout-invalid-high","description":"Serialize the high-range error with null measurement fields.","kind":"stdout","normalization":"json-object","inputs":{"case":"invalid-high"},"expected":{"status":"reading_out_of_range","count":0,"sum":0,"minimum":null,"maximum":null,"mean":null}},
    {"id":"report-write-invalid-high","description":"Return success after writing a high-range error report.","kind":"assertion-harness","inputs":{"case":"invalid-high"},"expected":{"return":0}},
    {"id":"analysis-invalid-tail","description":"Reject a late invalid reading without publishing partial totals.","kind":"assertion-harness","inputs":{"readings":[1,2,1001],"count":3},"expected":{"status":"reading_out_of_range","count":0,"sum":0,"minimum":0,"maximum":0,"mean":0}},
    {"id":"stdout-invalid-tail","description":"Serialize the invalid-tail status and no partial measurements.","kind":"stdout","normalization":"json-object","inputs":{"case":"invalid-tail"},"expected":{"status":"reading_out_of_range","count":0,"sum":0,"minimum":null,"maximum":null,"mean":null}},
    {"id":"report-write-invalid-tail","description":"Return success after writing an invalid-tail report.","kind":"assertion-harness","inputs":{"case":"invalid-tail"},"expected":{"return":0}},
    {"id":"analysis-too-many","description":"Reject count 31, before any traversal.","kind":"assertion-harness","inputs":{"count":31},"expected":{"status":"invalid_argument","count":0,"sum":0,"minimum":0,"maximum":0,"mean":0}},
    {"id":"stdout-too-many","description":"Serialize a capacity error without measurements.","kind":"stdout","normalization":"json-object","inputs":{"case":"too-many"},"expected":{"status":"invalid_argument","count":0,"sum":0,"minimum":null,"maximum":null,"mean":null}},
    {"id":"report-write-too-many","description":"Return success after writing a capacity error report.","kind":"assertion-harness","inputs":{"case":"too-many"},"expected":{"return":0}},
    {"id":"analysis-null-input","description":"Reject a null pointer for nonempty input and leave fields zero.","kind":"assertion-harness","inputs":{"readings":null,"count":1},"expected":{"status":"invalid_argument","count":0,"sum":0,"minimum":0,"maximum":0,"mean":0}},
    {"id":"stdout-null-input","description":"Serialize the null-input argument error.","kind":"stdout","normalization":"json-object","inputs":{"case":"null-input"},"expected":{"status":"invalid_argument","count":0,"sum":0,"minimum":null,"maximum":null,"mean":null}},
    {"id":"report-write-null-input","description":"Return success after writing a null-input error report.","kind":"assertion-harness","inputs":{"case":"null-input"},"expected":{"return":0}},
    {"id":"analysis-null-output","description":"Reject a null output-structure pointer.","kind":"assertion-harness","inputs":{"out_stats":null},"expected":{"status":"invalid_argument"}},
    {"id":"report-null-stream","description":"Reject a null output stream without writing.","kind":"assertion-harness","inputs":{"stream":null},"expected":{"return":-1}},
    {"id":"report-null-stats","description":"Reject a null stats pointer without writing.","kind":"assertion-harness","inputs":{"stats":null},"expected":{"return":-1}},
    {"id":"report-unknown-status","description":"Reject an undeclared status without writing.","kind":"assertion-harness","inputs":{"status":99},"expected":{"return":-1}},
    {"id":"adapter-sample","description":"Run the supplied fixed-input adapter independently of the grader harness.","kind":"stdout","scope":"adapter","normalization":"json-object","inputs":{"readings":[12,18,9,21,15,24]},"expected":{"status":"ok","count":6,"sum":99,"minimum":9,"maximum":24,"mean":16.5}}
  ],
